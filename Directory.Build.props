<Project>

  <!--
    VacaFlow — settings shared by every project.
    See docs/SAD.md for the architecture this layout enforces.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- A warning that is allowed to survive becomes a warning nobody reads. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <Company>BIG Solutions</Company>
    <Product>VacaFlow</Product>
    <Authors>BIG Solutions</Authors>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!--
    Exposes the solution root to the architecture tests, so the source-level
    assertions (no static clock, no service locator) can find the .cs files
    without a fragile relative path from the test binary.
  -->
  <ItemGroup>
    <AssemblyMetadata Include="SolutionRoot" Value="$(MSBuildThisFileDirectory)" />
  </ItemGroup>

</Project>
